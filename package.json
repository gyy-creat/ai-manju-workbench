{
  "name": "inkframe",
  "version": "0.3.0",
  "type": "module",
  "description": "影格 INKFRAME：AI 漫剧全流程生产台。剧本分集 → 角色一致性 → 场景环境 → 分镜 → 生图/生视频提示词（按模型语法族定向）→ 配音口型 → 资产对账 → 投产包导出，模型与 ComfyUI 走本机代理。",
  "license": "MIT",
  "author": "ai-manju-workbench contributors",
  "homepage": "https://github.com/gyy-creat/ai-manju-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyy-creat/ai-manju-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/gyy-creat/ai-manju-workbench/issues"
  },
  "keywords": [
    "ai",
    "manju",
    "comic-drama",
    "storyboard",
    "prompt-engineering",
    "text-to-image",
    "text-to-video",
    "comfyui",
    "short-drama",
    "react",
    "local-first"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "verify": "esbuild scripts/verify-seed.mjs --bundle --platform=node --format=esm --outfile=.tmp/verify.mjs --log-level=warning && node .tmp/verify.mjs",
    "pack": "node scripts/pack-handoff.mjs",
    "unpack": "node scripts/unpack-handoff.mjs",
    "portable": "node scripts/build-portable.mjs",
    "smoke": "node scripts/smoke.mjs",
    "app": "electron .",
    "app:dist": "npm run build && electron-builder",
    "app:trouble": "electron . --no-sandbox",
    "app:dir": "electron-builder --dir --win --x64 -c.directories.output=%TEMP%/mjw-build -c.win.signAndEditExecutable=false",
    "app:pack": "node scripts/set-exe-meta.mjs && node scripts/assemble-app.mjs",
    "app:install": "node scripts/install-app.mjs"
  },
  "build": {
    "appId": "dev.inkframe.app",
    "productName": "影格",
    "copyright": "Copyright © 2026 影格 INKFRAME contributors",
    "asar": false,
    "files": [
      "electron/**/*",
      "api.mjs",
      "server.mjs",
      "src/lib/**/*",
      "dist/**/*",
      "public/**/*",
      "assets/icon.ico",
      "LICENSE",
      "package.json",
      "!**/*.map",
      "!**/*.md"
    ],
    "directories": {
      "output": "exports/app",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "inkframe-${version}-x64.${ext}",
      "executableName": "影格"
    },
    "portable": {
      "artifactName": "inkframe-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "影格",
      "artifactName": "inkframe-${version}-setup.exe"
    },
    "compression": "normal",
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "bin": {
    "mjw-skills": "./bin/mjw-skills.mjs"
  },
  "files": [
    "bin/",
    "src/lib/",
    "api.mjs",
    "server.mjs",
    "public/",
    "README.md",
    "LICENSE"
  ]
}
